diff --git a/src/util/switchdiag.h b/src/util/switchdiag.h
new file mode 100644
index 0000000..2420ddd
--- /dev/null
+++ b/src/util/switchdiag.h
@@ -0,0 +1,63 @@
+/*
+** switchdiag.h
+**
+** Diagnostic trace for the Nintendo Switch libretro build (LonaRPG port).
+** Enabled only with -DMKXPZ_SWITCH_DIAG. Each line is appended to
+** /mkxp/logs/mkxp-diag.log on the SD card and flushed after every line,
+** so the last line survives an abort() in the graphics driver.
+*/
+
+#ifndef SWITCHDIAG_H
+#define SWITCHDIAG_H
+
+#ifdef MKXPZ_SWITCH_DIAG
+
+#include <cstdarg>
+#include <cstdio>
+#include <string>
+#include <sys/stat.h>
+
+inline FILE *mkxpzDiagFile()
+{
+	static FILE *f = std::fopen("/mkxp/logs/mkxp-diag.log", "a");
+	return f;
+}
+
+inline void mkxpzDiag(const char *fmt, ...)
+{
+	FILE *f = mkxpzDiagFile();
+	if (f == nullptr)
+		return;
+	va_list args;
+	va_start(args, fmt);
+	std::vfprintf(f, fmt, args);
+	va_end(args);
+	std::fputc('\n', f);
+	std::fflush(f);
+}
+
+/* Writes the exact source parts passed to glShaderSource into one file */
+inline void mkxpzDiagDumpSource(std::string name, const char *const *parts, const int *sizes, size_t count)
+{
+	/* Program names such as "BlurShader::HPass" are not valid FAT file names */
+	for (char &c : name)
+		if (c == ':')
+			c = '_';
+	mkdir("/mkxp/logs/glsl", 0777);
+	FILE *f = std::fopen(("/mkxp/logs/glsl/" + name).c_str(), "wb");
+	if (f == nullptr)
+	{
+		mkxpzDiag("[diag] cannot write /mkxp/logs/glsl/%s", name.c_str());
+		return;
+	}
+	for (size_t i = 0; i < count; ++i)
+		std::fwrite(parts[i], 1, sizes[i], f);
+	std::fclose(f);
+}
+
+#  define MKXPZ_DIAG(...) mkxpzDiag(__VA_ARGS__)
+#else
+#  define MKXPZ_DIAG(...) ((void)0)
+#endif // MKXPZ_SWITCH_DIAG
+
+#endif // SWITCHDIAG_H
