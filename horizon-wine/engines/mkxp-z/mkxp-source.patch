 using namespace mkxp_sandbox;
 
+static void apply_lona_palette(Exception &error, Bitmap &bitmap, const uint8_t *blob, size_t length) {
+    struct Filter { uint32_t x0, y0, x1, y1; std::unordered_map<uint32_t, uint32_t> colors; };
+    size_t pos = 0;
+    auto word = [&]() {
+        uint32_t value = uint32_t(blob[pos]) | uint32_t(blob[pos+1]) << 8 |
+                         uint32_t(blob[pos+2]) << 16 | uint32_t(blob[pos+3]) << 24;
+        pos += 4;
+        return value;
+    };
+    auto invalid = [&]() { error = Exception(Exception::MKXPError, "Invalid Lona palette command"); };
+    if (length < 4) { invalid(); return; }
+    const uint32_t count = word();
+    if (count > (length - pos) / 20) { invalid(); return; }
+    const int width = bitmap.getWidth(error), height = bitmap.getHeight(error);
+    if (error.is_error()) return;
+    std::vector<Filter> filters;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (length - pos < 20) { invalid(); return; }
+        Filter f;
+        f.x0 = word(); f.y0 = word(); f.x1 = word(); f.y1 = word();
+        const uint32_t pairs = word();
+        if (f.x0 > f.x1 || f.y0 > f.y1 || f.x1 > uint32_t(width) || f.y1 > uint32_t(height) ||
+            pairs > (length - pos) / 8) { invalid(); return; }
+        for (uint32_t j = 0; j < pairs; ++j) {
+            const uint32_t from = word(), to = word();
+            if ((from | to) > 0xffffff) { invalid(); return; }
+            f.colors[from] = to;
+        }
+        if (!f.colors.empty() && f.x0 != f.x1 && f.y0 != f.y1) filters.push_back(std::move(f));
+    }
+    if (pos != length) { invalid(); return; }
+    if (filters.empty()) return;
+    const uint64_t bytes = uint64_t(width) * uint64_t(height) * 4;
+    if (bytes > uint64_t(std::numeric_limits<int>::max())) { invalid(); return; }
+    if (bytes == 0) return;
+    std::unique_ptr<uint8_t, decltype(&std::free)> pixels(static_cast<uint8_t *>(std::malloc(size_t(bytes))), &std::free);
+    if (!pixels) { error = Exception(Exception::MKXPError, "Not enough memory for Lona palette conversion"); return; }
+    if (!bitmap.getRaw(error, pixels.get(), int(bytes))) return;
+    if (error.is_error()) return;
+    bool changed = false;
+    for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x) {
+        // The game's palette rectangles use bottom-first BGRA rows.
+        uint8_t *p = pixels.get() + (size_t(height - 1 - y) * width + x) * 4;
+        const uint32_t original = uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16;
+        uint32_t color = original;
+        for (const auto &f : filters) {
+            if (uint32_t(x) < f.x0 || uint32_t(x) >= f.x1 || uint32_t(y) < f.y0 || uint32_t(y) >= f.y1) continue;
+            const auto found = f.colors.find(original);
+            if (found != f.colors.end()) color = found->second;
+        }
+        if (color != original) {
+            p[0] = uint8_t(color); p[1] = uint8_t(color >> 8); p[2] = uint8_t(color >> 16);
+            changed = true;
+        }
+    }
+    if (changed) bitmap.replaceRaw(error, pixels.get(), int(bytes));
+}
+
+static VALUE lona_palette(VALUE self, VALUE value) {
+    struct coro : boost::asio::coroutine {
+        typedef decl_slots<wasm_ptr_t, int32_t> slots;
+        VALUE operator()(VALUE self, VALUE value) {
+            BOOST_ASIO_CORO_REENTER(this) {
+                SANDBOX_AWAIT_S(0, rb_string_value_ptr, &value);
+                SANDBOX_AWAIT_S(1, get_bytesize, value);
+                sb()->check_bounds(SANDBOX_SLOT(0), SANDBOX_SLOT(1));
+                SANDBOX_GUARD_L(apply_lona_palette(sb().e, *get_private_data<Bitmap>(self),
+                    &sb()->ref<uint8_t>(SANDBOX_SLOT(0)), SANDBOX_SLOT(1)));
+            }
+            return self;
+        }
+    };
+    return sb()->bind<struct coro>()()(self, value);
+}
