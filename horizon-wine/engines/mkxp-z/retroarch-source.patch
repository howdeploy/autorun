diff --git a/frontend/drivers/platform_switch.c b/frontend/drivers/platform_switch.c
index b3893af..d181dfe 100644
--- a/frontend/drivers/platform_switch.c
+++ b/frontend/drivers/platform_switch.c
@@ -111,6 +111,129 @@ static bool psmInitialized  = false;
 
 static AppletHookCookie applet_hook_cookie;
 
+#define LONA_LOADING_CPU_HZ 1785000000U
+static bool lona_loading_requested;
+static bool lona_loading_applied;
+static u32 lona_loading_restore_hz;
+static u64 lona_loading_deadline;
+static u64 lona_loading_next_poll;
+
+static Result lona_cpu_clock(u32 *hz, bool write)
+{
+   ClkrstSession session = {0};
+   Result rc = clkrstOpenSession(&session, PcvModuleId_CpuBus, 3);
+   if (R_SUCCEEDED(rc))
+   {
+      rc = write ? clkrstSetClockRate(&session, *hz)
+                 : clkrstGetClockRate(&session, hz);
+      clkrstCloseSession(&session);
+   }
+   return rc;
+}
+
+static int lona_restore_cpu(const char *reason)
+{
+   u32 actual = 0;
+   Result rc;
+   if (!lona_loading_applied)
+      return 1;
+   rc = lona_cpu_clock(&actual, false);
+   if (R_SUCCEEDED(rc) && actual != LONA_LOADING_CPU_HZ)
+   {
+      RARCH_LOG("[Lona CPU] External clock change: %u Hz; relinquishing boost.\n", actual);
+      lona_loading_applied = false;
+      lona_loading_requested = false;
+      return 1;
+   }
+   rc = lona_cpu_clock(&lona_loading_restore_hz, true);
+   if (R_SUCCEEDED(rc))
+      rc = lona_cpu_clock(&actual, false);
+   if (R_FAILED(rc) || actual != lona_loading_restore_hz)
+   {
+      RARCH_ERR("[Lona CPU] Restore failed (%s): rc=0x%x, actual=%u, expected=%u Hz.\n",
+            reason, rc, actual, lona_loading_restore_hz);
+      return 0;
+   }
+   lona_loading_applied = false;
+   RARCH_LOG("[Lona CPU] Restored %u Hz (%s).\n", actual, reason);
+   return 1;
+}
+
+int mkxp_switch_set_loading_boost(int enabled)
+{
+   u32 target = LONA_LOADING_CPU_HZ;
+   u32 actual = 0;
+   Result rc;
+   if (!enabled)
+   {
+      lona_loading_requested = false;
+      return lona_restore_cpu("loading ended");
+   }
+   if (hosversionBefore(8, 0, 0) || !platform_switch_has_focus)
+      return 0;
+   if (lona_loading_requested && armGetSystemTick() >= lona_loading_deadline)
+   {
+      lona_loading_requested = false;
+      lona_restore_cpu("10 minute limit");
+      return 0;
+   }
+   if (lona_loading_applied)
+      return 1;
+   if (!lona_loading_requested)
+   {
+      rc = lona_cpu_clock(&lona_loading_restore_hz, false);
+      if (R_FAILED(rc))
+      {
+         RARCH_ERR("[Lona CPU] Cannot read initial clock: rc=0x%x; boost skipped.\n", rc);
+         return 0;
+      }
+      if (lona_loading_restore_hz >= target)
+      {
+         RARCH_LOG("[Lona CPU] Already at %u Hz; leaving clocks unchanged.\n", lona_loading_restore_hz);
+         return 1;
+      }
+      lona_loading_requested = true;
+      lona_loading_deadline = armGetSystemTick() + armNsToTicks(600000000000ULL);
+   }
+   rc = lona_cpu_clock(&target, true);
+   if (R_SUCCEEDED(rc))
+   {
+      lona_loading_applied = true;
+      rc = lona_cpu_clock(&actual, false);
+   }
+   if (R_FAILED(rc) || actual != target)
+   {
+      RARCH_ERR("[Lona CPU] Boost failed: rc=0x%x, actual=%u Hz.\n", rc, actual);
+      lona_loading_requested = false;
+      lona_restore_cpu("boost failed");
+      return 0;
+   }
+   RARCH_LOG("[Lona CPU] Loading boost: %u -> %u Hz (CPU only).\n", lona_loading_restore_hz, actual);
+   return 1;
+}
+
+void mkxp_switch_loading_boost_poll(void)
+{
+   u64 now = armGetSystemTick();
+   u32 actual = 0;
+   if ((!lona_loading_requested && !lona_loading_applied) || now < lona_loading_next_poll)
+      return;
+   lona_loading_next_poll = now + armNsToTicks(1000000000ULL);
+   if (lona_loading_requested && now >= lona_loading_deadline)
+   {
+      lona_loading_requested = false;
+      lona_restore_cpu("10 minute limit");
+   }
+   else if (!lona_loading_requested)
+      lona_restore_cpu("restore retry");
+   else if (lona_loading_applied && R_SUCCEEDED(lona_cpu_clock(&actual, false)) && actual != LONA_LOADING_CPU_HZ)
+   {
+      RARCH_LOG("[Lona CPU] External clock change: %u Hz; relinquishing boost.\n", actual);
+      lona_loading_requested = false;
+      lona_loading_applied = false;
+   }
+}
+
